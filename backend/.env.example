# The existing .env is intentionally NEVER loaded. Use a NEW isolated database.
APP_HOST=127.0.0.1
APP_PORT=3000
APP_ORIGIN=http://localhost:4200
APP_ENV=development
APP_DATABASE_ENABLED=false
APP_DATABASE_DRIVER=postgres
APP_DATABASE_URL=
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
APP_PIN_SECRET=
APP_SESSION_HOURS=8
APP_COOKIE_SECURE=false

# Optional temporary local MySQL (development only):
# Employee authentication reads only; maintenance operations write to this local schema.
# APP_DATABASE_DRIVER=mysql-local
# APP_MYSQL_HOST=127.0.0.1
# APP_MYSQL_PORT=3306
# APP_MYSQL_DATABASE=datos_climatic
# APP_MYSQL_USER=
# APP_MYSQL_PASSWORD=

# Upcoming service warning: percentage of plan frequency, from 0 to 100.
APP_SERVICE_MARGIN_PERCENT=10
